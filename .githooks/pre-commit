#!/bin/sh
#
# pre-commit: 他サイト（今日の日本株ノート）の記事の誤混入を検出する
#
# 背景: 2026-08-13に浦安ぽーたるの記事が nikkei-note-blog へ誤ってcommitされ、
#       あちらのデプロイが2日間停止した。逆向きの事故も同様に防ぐ。
#
# 誤検知を避けるため、日本株ノート固有の要素がある場合のみ止める。
#
# 一時的に回避する場合: git commit --no-verify
#

ERR=0

FILES=$(git diff --cached --name-only --diff-filter=ACM | grep "^content/.*\.md$" || true)
[ -z "$FILES" ] && exit 0

for f in $FILES; do
	[ -f "$f" ] || continue

	fm=$(sed '1s/^\xEF\xBB\xBF//' "$f" | tr -d '\r' \
		| awk 'NR==1 && /^---$/ {f=1; next} f && /^---$/ {exit} f {print}')

	[ -z "$fm" ] && continue

	# --- 今日の日本株ノートの記事の混入検出 -----------------------
	# あちらは pubDate: を必須とし、浦安ぽーたる(Hugo)は date: を使う
	if echo "$fm" | grep -q '^pubDate:'; then
		echo "  [NG] $f : pubDate は「今日の日本株ノート」の書式です"
		echo "         → 日本株の記事を誤って投稿していませんか？"
		echo "         → 日本株の記事は nikkei-note-blog/src/content/blog/ に置いてください"
		echo "         → 浦安ぽーたるは date: を使います"
		ERR=1
	fi

	# 日本株ノート固有のフィールド
	for key in ogData weeklyThemes checkPoints nikkeiDate topixDate; do
		if echo "$fm" | grep -q "^${key}:"; then
			echo "  [NG] $f : ${key} は「今日の日本株ノート」固有のフィールドです"
			ERR=1
		fi
	done
done

if [ "$ERR" -ne 0 ]; then
	echo ""
	echo "commit を中止しました。上記を修正してください。"
	echo "（意図的に通す場合は git commit --no-verify）"
	exit 1
fi

exit 0
